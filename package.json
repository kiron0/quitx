{
  "name": "quitx-macos-app",
  "version": "1.1.2",
  "private": true,
  "description": "Build, install, and launch the native QuitX macOS app.",
  "scripts": {
    "build": "./Scripts/build.sh",
    "test": "set -o pipefail && swift test --build-system native -Xswiftc -F -Xswiftc /Library/Developer/CommandLineTools/Library/Developer/Frameworks 2>&1 | LC_ALL=C sed -E '/warning:.*build-system native.*deprecated/d'",
    "clean": "swift package clean && rm -rf .build/QuitX.app .build/*.dmg",
    "install": "npm run build && mkdir -p \"$HOME/Applications\" && ditto .build/QuitX.app \"$HOME/Applications/QuitX.app\"",
    "open": "open \"$HOME/Applications/QuitX.app\"",
    "ship": "./Scripts/ship.sh",
    "bump": "./Scripts/bump-version.sh",
    "start": "npm run ship",
    "dev:preview": "./Scripts/dev-preview.sh",
    "dev:welcome": "./Scripts/dev-preview.sh welcome",
    "dev:cpu": "./Scripts/dev-preview.sh cpu",
    "dev:memory": "./Scripts/dev-preview.sh memory",
    "dev:stats-cpu": "./Scripts/dev-preview.sh stats-cpu",
    "dev:stats-memory": "./Scripts/dev-preview.sh stats-memory",
    "dev:stats-battery": "./Scripts/dev-preview.sh stats-battery",
    "dev:settings": "./Scripts/dev-preview.sh settings"
  }
}
